#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR=/var/www/html

if [ "$SUPERVISOR_PHP_USER" != "root" ] && [ "$SUPERVISOR_PHP_USER" != "sail" ]; then
    echo "You should set SUPERVISOR_PHP_USER to either 'sail' or 'root'."
    exit 1
fi

if [ -n "${WWWUSER:-}" ]; then
    usermod -u $WWWUSER sail
fi

if [ ! -d /.composer ]; then
    mkdir /.composer
fi

chmod -R ugo+rw /.composer

mkdir -p \
    "$ROOT_DIR/bootstrap/cache" \
    "$ROOT_DIR/storage/app/public" \
    "$ROOT_DIR/storage/framework/cache" \
    "$ROOT_DIR/storage/framework/sessions" \
    "$ROOT_DIR/storage/framework/views" \
    "$ROOT_DIR/storage/logs"

chmod -R u+rwX,g+rwX,o+rX "$ROOT_DIR/storage" "$ROOT_DIR/bootstrap/cache"
rm -f "$ROOT_DIR"/bootstrap/cache/*.php
rm -rf "$ROOT_DIR"/storage/framework/views/*

if [ $# -gt 0 ]; then
    if [ "$SUPERVISOR_PHP_USER" = "root" ]; then
        exec "$@"
    else
        exec gosu sail "$@"
    fi
else
    if [ ! -f "$ROOT_DIR/vendor/autoload.php" ]; then
        gosu sail composer install --no-interaction --prefer-dist
    fi

    gosu sail /usr/local/bin/prepare-assets

    if [ "${SAIL_AUTO_MIGRATE:-true}" = "true" ]; then
        gosu sail php "$ROOT_DIR/artisan" migrate --force --no-interaction
    fi

    if [ -e "$ROOT_DIR/public/storage" ] && [ ! -L "$ROOT_DIR/public/storage" ]; then
        rm -rf "$ROOT_DIR/public/storage"
    fi

    if [ ! -e "$ROOT_DIR/public/storage" ]; then
        gosu sail php "$ROOT_DIR/artisan" storage:link --no-interaction || true
    fi

    if [ "${APP_ENV:-local}" = "production" ]; then
        gosu sail php "$ROOT_DIR/artisan" view:cache >/dev/null 2>&1 || true
        gosu sail php "$ROOT_DIR/artisan" config:cache >/dev/null 2>&1 || true
        gosu sail php "$ROOT_DIR/artisan" route:cache >/dev/null 2>&1 || true
        gosu sail php "$ROOT_DIR/artisan" event:cache >/dev/null 2>&1 || true
    else
        gosu sail php "$ROOT_DIR/artisan" view:clear >/dev/null 2>&1 || true
        gosu sail php "$ROOT_DIR/artisan" config:clear >/dev/null 2>&1 || true
        gosu sail php "$ROOT_DIR/artisan" route:clear >/dev/null 2>&1 || true
        gosu sail php "$ROOT_DIR/artisan" event:clear >/dev/null 2>&1 || true
    fi

    if [ "${SAIL_IMAGE_CACHE_WARM:-false}" = "true" ]; then
        gosu sail php "$ROOT_DIR/artisan" images:warm-optimized --no-interaction --quiet >/dev/null 2>&1 &
    fi

    exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
fi
