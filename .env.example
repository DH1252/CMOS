APP_NAME="CMOS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_CLIENT_TIMEZONE=Asia/Jakarta
SERVICE_ROLE=all
APP_SERVICE=app
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=true
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_SEED_DEVELOPMENT_DATA=false
APP_PREVIOUS_KEYS=
APP_PORT=80
VITE_PORT=5173
FORWARD_DB_PORT=3306
FORWARD_REVERB_PORT=8080
FORWARD_PHPMYADMIN_PORT=8081

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cmos
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
SAIL_DB_USERNAME=sail
SAIL_DB_PASSWORD=password

CACHE_STORE=database
CACHE_PREFIX=cmos-cache-
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_COOKIE=cmos_session
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SAIL_AUTO_MIGRATE=true
SAIL_XDEBUG_MODE=off
SAIL_XDEBUG_CONFIG=client_host=host.docker.internal
SAIL_QUEUE_CONNECTION=database
SAIL_QUEUE_ENABLED=true
SAIL_SCHEDULER_ENABLED=true
SAIL_REVERB_ENABLED=true
SAIL_SSR_ENABLED=true
SAIL_BUILD_ASSETS=true
SAIL_IMAGE_CACHE_WARM=true
INERTIA_SSR_ENABLED=true
INERTIA_SSR_RUNTIME=node
INERTIA_SSR_ENSURE_RUNTIME_EXISTS=true
INERTIA_SSR_ENSURE_BUNDLE_EXISTS=true
WWWUSER=1000
WWWGROUP=1000

APP_SERVER_HOST=127.0.0.1
APP_SERVER_PORT=8000

QUEUE_WORKER_QUEUE=default
QUEUE_WORKER_TRIES=3
QUEUE_WORKER_TIMEOUT=90
QUEUE_WORKER_SLEEP=3
QUEUE_WORKER_MEMORY=256

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=cmos-reverb-app
REVERB_APP_KEY=cmos-reverb-key
REVERB_APP_SECRET=cmos-reverb-secret
# Internal Laravel-to-Reverb connection inside the application container.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Reverb process listener. Keep this aligned with FORWARD_REVERB_PORT.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SERVER_PATH=
REVERB_DEBUG=false
REVERB_LOG_FILE=
REVERB_LOG_LEVEL=warning
REVERB_LOG_DAILY_DAYS=7
REVERB_MAX_REQUEST_SIZE=10000
REVERB_APP_PING_INTERVAL=60
REVERB_APP_ACTIVITY_TIMEOUT=30
REVERB_APP_MAX_CONNECTIONS=
REVERB_APP_MAX_MESSAGE_SIZE=10000
REVERB_APP_ACCEPT_CLIENT_EVENTS_FROM=members
REVERB_APP_RATE_LIMITING_ENABLED=true
REVERB_APP_RATE_LIMIT_MAX_ATTEMPTS=60
REVERB_APP_RATE_LIMIT_DECAY_SECONDS=60
REVERB_APP_RATE_LIMIT_TERMINATE=false

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_URL=
MAIL_EHLO_DOMAIN=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_APPLICATION_NAME="${APP_NAME}"
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_JSON=storage/app/private/google-service-account.json
GOOGLE_CALENDAR_IMPERSONATE_USER=
GOOGLE_API_KEY=

SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

POSTMARK_API_KEY=
RESEND_API_KEY=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
# Sail defaults. Set these to the public WebSocket host, port, and scheme when
# using a reverse proxy or deploying outside the local machine.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
